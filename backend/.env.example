# Application
APP_ENV=development
APP_NAME=FlowDrive API
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/flowdrive
SESSION_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
COOKIE_SECURE=false
SENTRY_DSN=

# Google OAuth and Google Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_DRIVE_FOLDER_NAME=FlowDrive

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto

# Uploads and cleanup
UPLOAD_MAX_BYTES=5368709120
TEMP_CLEANUP_INTERVAL_MINUTES=15
CRON_SECRET=generate-a-secure-random-secret-key

